# Empty = call the API on the same origin (nginx proxies /api in production,
# Vite proxies it in dev). Only set a full URL if the API is on another domain.
VITE_API_BASE_URL=
VITE_REFRESH_INTERVAL=10000
VITE_LOG_PAGE_SIZE=50
# Dev only: where `npm run dev` forwards /api
DEV_API_TARGET=http://192.168.1.6:8000
